# Runtime
APP_ENV=local
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=20s

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Database
DATABASE_URL=postgres://prism:prism@localhost:5432/prism?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_CONN_MAX_LIFETIME=30m

# Auth (session tokens for the console)
# In local mode a static HS256 secret is accepted. In non-local envs an OIDC issuer is required.
AUTH_MODE=dev
AUTH_DEV_HS256_SECRET=local-dev-secret-change-me
AUTH_OIDC_ISSUER=
AUTH_OIDC_AUDIENCE=prism-console

# Service-to-service token used by internal endpoints (e.g. ingest gateway key verification)
INTERNAL_API_TOKEN=local-internal-token-change-me

# OpenTelemetry
OTEL_ENABLED=true
OTEL_SERVICE_NAME=prism-controlplane
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_TRACES_SAMPLER_RATIO=1.0
