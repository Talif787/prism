# Runtime
APP_ENV=local
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=20s

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Database
DATABASE_URL=postgres://prism:prism@localhost:5432/prism?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_CONN_MAX_LIFETIME=30m

# Auth (session tokens for the console)
# In local mode a static HS256 secret is accepted. In non-local envs an OIDC issuer is required.
AUTH_MODE=dev
AUTH_DEV_HS256_SECRET=local-dev-secret-change-me
AUTH_OIDC_ISSUER=
AUTH_OIDC_AUDIENCE=prism-console

# Service-to-service token used by internal endpoints (e.g. ingest gateway key verification)
INTERNAL_API_TOKEN=local-internal-token-change-me

# OpenTelemetry
OTEL_ENABLED=true
OTEL_SERVICE_NAME=prism-controlplane
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_TRACES_SAMPLER_RATIO=1.0

# ============================================================================
# Phase 2: ingest gateway and outbox relay
# ============================================================================

# Ingest gateway HTTP port (OTLP/HTTP receiver). Overrides HTTP_PORT for the gateway.
# HTTP_PORT=8090

# Redis (auth cache, rate limiter, cardinality guard)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# Kafka / Redpanda
KAFKA_BROKERS=localhost:9092
KAFKA_REQUIRED_ACKS=-1
KAFKA_AUTO_CREATE_TOPICS=true
KAFKA_TOPIC_METRICS=telemetry.metrics
KAFKA_TOPIC_LOGS=telemetry.logs
KAFKA_TOPIC_TRACES=telemetry.traces
KAFKA_TOPIC_EVENTS=tenancy.events

# Gateway to control-plane key verification
CONTROL_PLANE_VERIFY_URL=http://localhost:8080/internal/v1/keys/verify
CONTROL_PLANE_TIMEOUT=3s
AUTH_CACHE_TTL=60s
AUTH_NEGATIVE_CACHE_TTL=10s

# Rate limiting (token bucket, per tenant, tokens = data points)
RATE_LIMIT_PER_SECOND=50000
RATE_LIMIT_BURST=100000

# Cardinality guard (approximate distinct metric series per tenant, per window)
CARDINALITY_BUDGET=100000
CARDINALITY_WINDOW=24h
CARDINALITY_ENFORCE=false

# Request body cap for OTLP/HTTP
MAX_BODY_BYTES=4194304

# Relay
RELAY_POLL_INTERVAL=1s
RELAY_BATCH_SIZE=100
RELAY_MAX_ATTEMPTS=10

# ============================================================================
# Phase 3: stream consumer and ClickHouse
# ============================================================================

# Consumer health server port (liveness/readiness). Overrides HTTP_PORT for consumer.
# HTTP_PORT=8091

# ClickHouse (native protocol on 9000)
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DIAL_TIMEOUT=10s
CLICKHOUSE_MAX_OPEN_CONNS=10

# Consumer group and batching
KAFKA_CONSUMER_GROUP=prism-consumer
CONSUMER_BATCH_MAX_ROWS=5000
CONSUMER_BATCH_MAX_WAIT=1s

# ============================================================================
# Phase 4: query service (read path)
# ============================================================================

# HTTP_PORT for the query service is 8092 (set per-service in compose).
# Reuses CLICKHOUSE_*, REDIS_ADDR, CONTROL_PLANE_VERIFY_URL, INTERNAL_API_TOKEN.
QUERY_NAME_CACHE_TTL=10s
QUERY_MAX_EXECUTION_SECONDS=15

# ============================================================================
# Phase 3b: OTLP/gRPC receiver (gateway)
# ============================================================================
# The gateway serves OTLP/gRPC alongside OTLP/HTTP, sharing the same pipeline.
GATEWAY_GRPC_ENABLED=true
GRPC_HOST=0.0.0.0
GRPC_PORT=4317

# --- Alerting service (Phase 5) ---
# Reuses DATABASE_URL, CLICKHOUSE_*, REDIS_ADDR, CONTROL_PLANE_VERIFY_URL, INTERNAL_API_TOKEN.
# The API requires admin-scoped API keys. Alerting tables are created by the control
# plane migrator (migration 0003); the alerter runs no migrations of its own.
ALERTER_EVAL_INTERVAL=15s
ALERTER_WEBHOOK_TIMEOUT=5s
ALERTER_MAX_EXECUTION_SECONDS=15
